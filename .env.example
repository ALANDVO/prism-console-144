# Database
DATABASE_URL=sqlite+aiosqlite:///./prism.db

# Encryption key for API keys (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-generated-fernet-key-here

# Health check settings
HEALTH_CHECK_INTERVAL_SECONDS=300
HEALTH_CHECK_TIMEOUT_SECONDS=10
HEALTH_CHECK_CONCURRENCY=5

# Server
HOST=0.0.0.0
PORT=8000
